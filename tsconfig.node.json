{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "outDir": "out/types-node"
  },
  "include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/plugins/**/*", "tests/**/*", "vitest.config.ts", "src/renderer/src/store/toasts.ts", "src/renderer/src/features/check/trouble.ts", "src/renderer/src/features/editor/diffView.ts"]
}
